# Copy this file to ~/.config/devin-workflow/.env
# and fill in the values with your own credentials.

DEVIN_API_KEY=cog_xxxxxxxxxxxxxxxxx

DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxxx

# Optional
DEVIN_PLAYBOOK_ID=

# Optional.
# If empty, the CLI automatically detects the repository
# from the current Git remote.
DEVIN_REPO=.
